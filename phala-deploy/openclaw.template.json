{
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "__GATEWAY_AUTH_TOKEN__",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "dangerouslyDisableDeviceAuth": true
    },
    "http": {
      "endpoints": {
        "mux": {
          "enabled": true,
          "baseUrl": "__MUX_BASE_URL__",
          "registerKey": "__MUX_REGISTER_KEY__",
          "inboundUrl": "__MUX_INBOUND_URL__"
        }
      }
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "update": {
    "checkOnStart": false,
    "selfUpdate": {
      "enabled": false,
      "reason": "This Clawdi deployment is managed by the Clawdi dashboard. Please use the Clawdi dashboard to update this deployment."
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "mux": { "enabled": true, "timeoutMs": 30000 },
      "reactionLevel": "extensive",
      "actions": {
        "sticker": true
      },
      "accounts": {
        "default": { "enabled": true, "dmPolicy": "pairing", "groupPolicy": "allowlist" }
      }
    },
    "discord": {
      "enabled": true,
      "groupPolicy": "open",
      "mux": { "enabled": true, "timeoutMs": 30000 },
      "guilds": { "*": { "requireMention": false } },
      "accounts": {
        "default": { "enabled": true, "groupPolicy": "open" }
      }
    },
    "whatsapp": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "mux": { "enabled": true, "timeoutMs": 30000 },
      "accounts": {
        "default": { "enabled": true, "dmPolicy": "pairing", "groupPolicy": "allowlist" }
      }
    }
  },
  "plugins": {
    "entries": {
      "telegram": { "enabled": true },
      "discord": { "enabled": true },
      "whatsapp": { "enabled": true }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "maxConcurrent": 4,
      "subagents": { "maxConcurrent": 8 },
      "compaction": { "mode": "safeguard" },
      "model": { "primary": "__MODEL_PRIMARY__" },
      "models": {
        "openai-codex/gpt-5.4": { "alias": "GPT-5.4" },
        "openai-codex/gpt-5.3-codex": { "alias": "Codex" },
        "openai-codex/gpt-5.1-codex-mini": { "alias": "Codex Mini" }
      }
    }
  },
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "__OPENAI_BASE_URL__",
        "apiKey": "__OPENAI_API_KEY__",
        "headers": { "x-api-key": "__OPENAI_HEADER_API_KEY__" },
        "models": [{ "id": "gpt-4o-transcribe", "name": "gpt-4o-transcribe" }]
      },
      "openai-codex": {
        "baseUrl": "__CODEX_API_ENDPOINT__",
        "apiKey": "__CODEX_API_KEY__",
        "headers": { "x-api-key": "__CODEX_HEADER_API_KEY__" },
        "models": [
          {
            "id": "gpt-5.3-codex",
            "name": "gpt-5.3-codex",
            "reasoning": true,
            "input": ["text", "image"]
          },
          { "id": "gpt-5.2-codex", "name": "gpt-5.2-codex" },
          { "id": "gpt-5.1-codex-max", "name": "gpt-5.1-codex-max" },
          { "id": "gpt-5.1-codex", "name": "gpt-5.1-codex" },
          { "id": "gpt-5.2", "name": "gpt-5.2" },
          { "id": "gpt-5.1", "name": "gpt-5.1" },
          { "id": "gpt-5-codex", "name": "gpt-5-codex" },
          { "id": "gpt-5", "name": "gpt-5" },
          {
            "id": "gpt-5.1-codex-mini",
            "name": "gpt-5.1-codex-mini",
            "reasoning": true,
            "input": ["text", "image"]
          },
          { "id": "gpt-5-codex-mini", "name": "gpt-5-codex-mini" }
        ]
      }
    }
  },
  "tools": {
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "media": {
      "audio": {
        "enabled": true,
        "models": [{ "provider": "openai", "model": "gpt-4o-transcribe" }]
      }
    },
    "web": {
      "search": {
        "enabled": "__WEB_SEARCH_ENABLED__",
        "provider": "__WEB_SEARCH_PROVIDER__",
        "apiKey": "__BRAVE_SEARCH_API_KEY__",
        "baseUrl": "__BRAVE_SEARCH_BASE_URL__",
        "perplexity": {
          "apiKey": "__PERPLEXITY_API_KEY__",
          "baseUrl": "__PERPLEXITY_BASE_URL__"
        }
      },
      "fetch": {
        "firecrawl": {
          "enabled": "__FIRECRAWL_ENABLED__",
          "apiKey": "__FIRECRAWL_API_KEY__",
          "baseUrl": "__FIRECRAWL_BASE_URL__"
        }
      }
    }
  },
  "skills": {
    "entries": {
      "gog": { "enabled": false },
      "notion": { "enabled": false },
      "composio": {}
    }
  }
}
